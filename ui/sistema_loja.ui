  <property name="styleSheet">
   <string notr="true">/* Fundo Geral */
QMainWindow, QWidget#centralwidget {
    background-color: #18181B;
    color: #F4F4F5;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

/* Painel Principal (StackedWidget) */
QStackedWidget#hud {
    background-color: #27272A;
    border-radius: 12px;
    border: 1px solid #3F3F46;
}

QStackedWidget#hud &gt; QWidget {
    background-color: transparent;
}

/* Botões Padrão (Menu Lateral e Secundários) */
QPushButton {
    background-color: #3F3F46;
    color: #F4F4F5;
    font-size: 14pt;
    font-weight: bold;
    border-radius: 8px;
    padding: 12px 18px;
    border: 1px solid #52525B;
}

QPushButton:hover {
    background-color: #52525B;
    border-color: #EAB308;
}

QPushButton:pressed {
    background-color: #27272A;
}

/* Botões de Ação Principal (Dourado/Âmbar) */
QPushButton#pushButton_5, QPushButton#pushButton_10, 
QPushButton#pushButton_11, QPushButton#pushButton_12, 
QPushButton#pushButton_13, QPushButton#pushButton_15, 
QPushButton#pushButton_17 {
    background-color: #EAB308;
    color: #18181B;
    border: none;
}

QPushButton#pushButton_5:hover, QPushButton#pushButton_10:hover,
QPushButton#pushButton_11:hover, QPushButton#pushButton_12:hover,
QPushButton#pushButton_13:hover, QPushButton#pushButton_15:hover,
QPushButton#pushButton_17:hover {
    background-color: #FACC15;
}

/* Botão Finalizar Compra (Verde Destaque) */
QPushButton#pushButton_7 {
    background-color: #16A34A;
    color: #FFFFFF;
    font-size: 14pt;
    border: none;
}

QPushButton#pushButton_7:hover {
    background-color: #22C55E;
}

/* Botão Remover (Alerta Sutil) */
QPushButton#pushButton_6:hover {
    border-color: #EF4444;
    color: #FCA5A5;
}

/* Campos de Texto e Inputs */
QLineEdit, QPlainTextEdit, QSpinBox {
    background-color: #18181B;
    color: #F4F4F5;
    font-size: 13pt;
    border: 1px solid #52525B;
    border-radius: 8px;
    padding: 8px 12px;
}

QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus {
    border: 2px solid #EAB308;
}

/* Tabelas */
QTableWidget {
    background-color: #18181B;
    alternate-background-color: #222226;
    color: #F4F4F5;
    gridline-color: #3F3F46;
    font-size: 12pt;
    border-radius: 8px;
    border: 1px solid #3F3F46;
    selection-background-color: #EAB308;
    selection-color: #18181B;
}

QHeaderView::section {
    background-color: #3F3F46;
    color: #EAB308;
    font-weight: bold;
    font-size: 12pt;
    padding: 8px;
    border: none;
}

/* Labels Gerais */
QLabel {
    color: #F4F4F5;
    font-size: 13pt;
}</string>
